# Copy this to .env and fill in your Anthropic API key
# Get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx

# Model tiers (defaults): routine agents + orchestrator routing use
# claude-sonnet-4-6; reasoning-heavy agents (crypto, reversing, blockchain)
# escalate to claude-opus-5. Override precedence: per-agent > global > tier.
#
# RECON_MODEL=claude-sonnet-4-6        # global: force ONE model everywhere
# RECON_STRONG_MODEL=claude-opus-5     # override the strong tier only
# RECON_MODEL_CRYPTO=claude-opus-5     # per-agent override (any agent name)
# RECON_MODEL_WEB_EXPLOIT=claude-haiku-4-5
